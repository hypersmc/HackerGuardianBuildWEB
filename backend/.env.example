APP_NAME="HackerGuardian Web"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Keep this empty for localhost so the browser creates host-only cookies.
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8000

CACHE_STORE=file
QUEUE_CONNECTION=sync

HG_API_URL=http://127.0.0.1:8787
HG_API_KEY_ID=
HG_API_SECRET=
HG_API_CONNECT_TIMEOUT=3
HG_API_TIMEOUT=10
